----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/shell", "moonbitlang/async@0.22.5/fs", "moonbitlang/core/json" }
----
fn field(value : Json, key : String) -> Json { match value { Object(f) => f.get(key).unwrap_or(Json::null()); _ => Json::null() } }
async fn main {
  let tree = @shell.Cmd("moon", ["tree", "--json"], stdout=Capture).output()
  tree.check()
  guard field(@json.parse(tree.stdout()), "modules") is Array(modules) && !modules.is_empty() else { fail("module graph required") }
  guard field(modules[0], "name") == Json::string("miik-su/moonoperator") else { fail("run this audit from the root module") }
  guard field(modules[0], "version") is String(version) && !version.is_empty() && version.all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || c == '.' || c == '-' || c == '+') else { fail("safe module version required") }
  let packaged = @shell.Cmd("moon", ["package"], stdout=Capture, stderr=Capture).output(timeout_ms=120000)
  if packaged.exit_code() != 0 { println(packaged.stdout()); println(packaged.stderr()) }
  packaged.check()
  let archive = "_build/publish/miik-su-moonoperator-" + version + ".zip"
  // Windows ships bsdtar with ZIP support; GNU tar on Linux does not read ZIP.
  let tar_version = @shell.Cmd("tar", ["--version"], stdout=Capture, stderr=Capture).output(timeout_ms=10000)
  let tool = if tar_version.exit_code() == 0 && tar_version.stdout().contains("bsdtar") { "tar" } else { "unzip" }
  let arguments = if tool == "tar" { ["-tf", archive] } else { ["-Z", "-1", archive] }
  let listing = @shell.Cmd(tool, arguments, stdout=Capture, stderr=Capture).output(timeout_ms=10000, max_output_bytes=262144)
  if listing.exit_code() != 0 { println("archive listing tool: " + tool); println(listing.stderr()) }
  listing.check()
  let files : Array[String] = []
  for line in listing.stdout().split("\n") {
    let path = line.trim().to_owned().replace_all(old="\\", new="/")
    if path.is_empty() { continue }
    guard !path.has_prefix("/") && !path.contains(":") else { fail("absolute archive path rejected") }
    for segment in path.split("/") {
      guard !["..", ".git", "_build", "target", ".mooncakes", ".tools", "node_modules", "distribution-evidence"].contains(segment.to_owned()) &&
        segment != ".env" && !segment.has_prefix(".env.") && !segment.has_suffix(".key") && !segment.has_suffix(".kubeconfig") && !segment.has_suffix(".log") else { fail("generated or credential-like file rejected: " + path) }
    }
    files.push(path)
  }
  let notices = [
    "LICENSE", "NOTICE", "LICENSING.md", "THIRD_PARTY_NOTICES.md",
    "third_party/async-LICENSE", "third_party/yaml-LICENSE", "third_party/moonbit-core-LICENSE",
  ]
  for required in ["moon.mod", "README.md"] {
    guard files.contains(required) else { fail("required package file missing: " + required) }
  }
  for notice in notices {
    guard files.iter().filter(path => path == notice).count() == 1 else {
      fail("missing or duplicate distribution notice: " + notice)
    }
    let args = if tool == "tar" { ["-xOf", archive, notice] } else { ["-p", archive, notice] }
    let extracted = @shell.Cmd(tool, args, stdout=Capture, stderr=Capture).output(
      timeout_ms=10000, max_output_bytes=262144,
    )
    extracted.check()
    let expected = @fs.read_file(notice).binary()
    guard !expected.is_empty() && extracted.stdout_bytes() == expected else {
      fail("archived distribution notice differs from source: " + notice)
    }
  }
  for (notice, resolved) in [
    ("third_party/async-LICENSE", ".mooncakes/moonbitlang/async/LICENSE"),
    ("third_party/yaml-LICENSE", ".mooncakes/moonbit-community/yaml/LICENSE"),
  ] {
    guard @fs.read_file(notice).binary() == @fs.read_file(resolved).binary() else {
      fail("bundled license differs from resolved dependency: " + notice)
    }
  }
  let source = @shell.Cmd("git", ["rev-parse", "HEAD"], stdout=Capture).output()
  source.check()
  let status = @shell.Cmd("git", ["status", "--porcelain"], stdout=Capture).output()
  status.check()
  let report : Json = { "source_commit": source.stdout().trim().to_owned(), "worktree_modified": !status.stdout().trim().is_empty(), "archive": archive, "archive_listing_tool": tool, "files": files, "required_notices_present": true, "archive_notice_bytes_match_checkout": true, "archive_notices": notices, "bundled_mooncakes_licenses_match_resolved": true, "generated_and_credential_like_paths_absent": true, "scope": "actual offline source ZIP paths and notice contents plus resolved Mooncakes license copies; not a content secret scan, installed-package test or publication", "published": false }
  @fs.write_file("package-audit-report.json", report.stringify(indent=2))
  println("Verified \{files.length()} actual archive paths, seven notice payloads and two resolved dependency licenses; no publication performed")
}
