----
import {
  "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/shell",
  "moonbitlang/async@0.22.5/fs", "moonbitlang/core/json", "moonbitlang/core/env",
}
----

fn field(json : Json, key : String) -> Json {
  match json { Object(fields) => fields.get(key).unwrap_or(Json::null()); _ => Json::null() }
}

async fn kubectl(args : Array[String], input? : String = "") -> String {
  let prefix = ["--context", "kind-moonoperator-e2e", "-n", "moonoperator-e2e"]
  prefix.append(args)
  let output = @shell.Cmd("kubectl", prefix, stdin=Text(input)).output(timeout_ms=180000)
  if output.exit_code() != 0 { println(output.stderr()) }
  output.check()
  output.stdout()
}

async fn replicas(expected : Double) -> Unit {
  for attempt in 0..<90 {
    let output = @shell.Cmd("kubectl", ["--context", "kind-moonoperator-e2e", "-n", "moonoperator-e2e", "get", "deployment", "demo-app", "-o", "json"]).output(timeout_ms=5000)
    if output.exit_code() == 0 {
      let resource = @json.parse(output.stdout())
      if field(field(resource, "spec"), "replicas") == Json::number(expected) { return }
    }
    if attempt == 89 { fail("MoonApp replicas did not converge") }
    @async.sleep(1000)
  }
}

async fn main {
  // The script only touches an explicitly named disposable Kind context.
  let args = @env.args()
  guard args.length() == 2 else { fail("usage: kind-e2e.mbtx MANIFEST_GENERATOR_BINARY") }
  let ns : Json = { "apiVersion": "v1", "kind": "Namespace", "metadata": { "name": "moonoperator-e2e" } }
  ignore(kubectl(["apply", "-f", "-"], input=ns.stringify()))
  let bundle = @shell.Cmd(args[1], [], env={ "MOONOPERATOR_NAMESPACE": "moonoperator-e2e" }).output(timeout_ms=10000)
  bundle.check()
  ignore(kubectl(["apply", "-f", "-"], input=bundle.stdout()))
  ignore(kubectl(["wait", "--for=condition=Established", "crd/moonapps.moonoperator.dev", "--timeout=60s"]))
  let identity = "system:serviceaccount:moonoperator-e2e:moonoperator"
  for (verb, resource, expected) in [("get", "moonapps", "yes"), ("create", "deployments.apps", "yes"), ("update", "moonapps/finalizers", "yes"), ("get", "secrets", "no"), ("update", "networkpolicies.networking.k8s.io", "no"), ("delete", "deployments.apps", "no")] {
    let result = @shell.Cmd("kubectl", ["--context", "kind-moonoperator-e2e", "-n", "moonoperator-e2e", "auth", "can-i", verb, resource, "--as", identity], stdout=Capture).output(timeout_ms=10000)
    assert_eq(result.stdout().trim().to_owned(), expected)
  }
  let invalid : Json = { "apiVersion": "moonoperator.dev/v1", "kind": "MoonApp", "metadata": { "name": "invalid-image", "namespace": "moonoperator-e2e" }, "spec": { "image": "" } }
  let rejected = @shell.Cmd("kubectl", ["--context", "kind-moonoperator-e2e", "-n", "moonoperator-e2e", "apply", "--dry-run=server", "-f", "-"], stdin=Text(invalid.stringify()), stdout=Capture, stderr=Capture).output(timeout_ms=10000)
  assert_true(rejected.exit_code() != 0)
  assert_true(rejected.stderr().contains("image"))
  assert_true(rejected.stderr().contains("at least") || rejected.stderr().contains("Too short"))
  let probe : Json = { "apiVersion": "v1", "kind": "List", "items": [
    { "apiVersion": "v1", "kind": "ServiceAccount", "metadata": { "name": "moonoperator-probe", "namespace": "moonoperator-e2e" } },
    { "apiVersion": "rbac.authorization.k8s.io/v1", "kind": "Role", "metadata": { "name": "moonoperator-probe", "namespace": "moonoperator-e2e" }, "rules": [{ "apiGroups": [""], "resources": ["configmaps"], "verbs": ["get", "list", "watch", "create", "update", "patch", "delete"] }] },
    { "apiVersion": "rbac.authorization.k8s.io/v1", "kind": "RoleBinding", "metadata": { "name": "moonoperator-probe", "namespace": "moonoperator-e2e" }, "subjects": [{ "kind": "ServiceAccount", "name": "moonoperator-probe", "namespace": "moonoperator-e2e" }], "roleRef": { "apiGroup": "rbac.authorization.k8s.io", "kind": "Role", "name": "moonoperator-probe" } },
    { "apiVersion": "v1", "kind": "Pod", "metadata": { "name": "client-probe", "namespace": "moonoperator-e2e" }, "spec": { "serviceAccountName": "moonoperator-probe", "restartPolicy": "Never", "containers": [{ "name": "probe", "image": "moonoperator-probe:dev", "imagePullPolicy": "Never", "command": ["/usr/local/bin/client-probe"] }] } },
  ] }
  ignore(kubectl(["apply", "-f", "-"], input=probe.stringify()))
  ignore(kubectl(["wait", "--for=jsonpath={.status.phase}=Succeeded", "pod/client-probe", "--timeout=90s"]))
  let client_report = kubectl(["logs", "pod/client-probe"])
  let mut parsed_report : Json = Json::null()
  for line in client_report.split("\n") {
    if line.trim().has_prefix("{") { parsed_report = @json.parse(line) }
  }
  assert_eq(field(parsed_report, "real_api_crud_patch_paginate_conflict_forbidden_watch"), Json::boolean(true))
  @fs.write_file("cluster-client-report.json", parsed_report.stringify())
  ignore(kubectl(["apply", "-f", "config/operator.yaml"]))
  ignore(kubectl(["apply", "-f", "config/diagnostics-networkpolicy.yaml"]))
  ignore(kubectl(["rollout", "status", "deployment/moonoperator", "--timeout=120s"]))
  ignore(kubectl(["apply", "-f", "config/moonapp.yaml"]))
  replicas(3.0)
  for attempt in 0..<60 {
    let app = @json.parse(kubectl(["get", "moonapp", "demo-app", "-o", "json"]))
    let status = field(app, "status")
    if field(status, "observedGeneration") == field(field(app, "metadata"), "generation") && field(status, "conditions") is Array(conditions) && conditions.any(c => field(c, "type") == Json::string("ResourcesApplied") && field(c, "status") == Json::string("True")) {
      assert_true(conditions.any(c => field(c, "type") == Json::string("Ready") && field(c, "status") == Json::string("Unknown")))
      break
    }
    if attempt == 59 { fail("current generation conditions were not published") }
    @async.sleep(500)
  }
  ignore(kubectl(["get", "service", "demo-app"]))
  ignore(kubectl(["patch", "moonapp", "demo-app", "--type=merge", "-p", "{\"spec\":{\"replicas\":2}} "]))
  replicas(2.0)
  ignore(kubectl(["scale", "deployment/demo-app", "--replicas=1"]))
  replicas(2.0)
  ignore(kubectl(["delete", "deployment", "demo-app", "--wait=true"]))
  replicas(2.0)
  ignore(kubectl(["rollout", "restart", "deployment/moonoperator"]))
  ignore(kubectl(["rollout", "status", "deployment/moonoperator", "--timeout=120s"]))
  replicas(2.0)
  ignore(kubectl(["delete", "moonapp", "demo-app", "--wait=true"]))
  ignore(kubectl(["wait", "--for=delete", "deployment/demo-app", "--timeout=90s"]))
  ignore(kubectl(["wait", "--for=delete", "service/demo-app", "--timeout=90s"]))
  let report : Json = { "suite": "kind-moonapp", "create_update_drift_restart_gc": true, "empty_image_rejected_by_admission": true, "rbac_positive_negative": true, "generation_conditions": true, "ready_not_overclaimed": true }
  @fs.write_file("kind-e2e-report.json", report.stringify(indent=2))
  println("Kind MoonApp create/update/drift/restart/GC verified")
}
