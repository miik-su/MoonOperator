----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs", "moonbitlang/core/json", "moonbitlang/core/env" }
----

///|
fn field(value : Json, key : String) -> Json {
  match value { Object(fields) => fields.get(key).unwrap_or(Json::null()); _ => Json::null() }
}

///|
fn cell(value : Json) -> String {
  let s = match value { String(s) => s; Null => "not recorded"; _ => value.stringify() }
  s.replace_all(old="|", new="\\|").replace_all(old="\n", new=" ").replace_all(old="\r", new=" ")
}

///|
async fn read(path : String) -> Json {
  if !@fs.exists(path) { return Json::null() }
  @json.parse(@fs.read_file(path).text())
}

///|
async fn main {
  let args = @env.args()
  guard args.length() >= 2 else { fail("usage: report-summary.mbtx native|kind|wasm [JOB_STATUS] [OBSERVATION_DIR]") }
  let suite = args[1]
  let state = if args.length() > 2 { args[2] } else { "local observation" }
  let directory = if args.length() > 3 { args[3] } else if suite == "native" { "ci-evidence" } else { "." }
  let out = StringBuilder()
  out.write_string("## MoonOperator " + suite + "\n\nStatus before report upload: **" + cell(Json::string(state)) + "**. GitHub shows the final workflow status. Missing evidence is not a pass.\n\n")
  if @env.get_env_var("GITHUB_SHA") is Some(sha) { out.write_string("Source commit: `" + sha + "`.\n\n") }
  match suite {
    "native" => {
      let bench = field(read(directory + "/benchmark.json"), "result")
      out.write_string("Dataset: " + cell(field(bench, "dataset_objects")) + " synthetic objects; platform: " + cell(field(bench, "platform")) + "; target: " + cell(field(bench, "target")) + ".\n\n| Observation | Iterations | Mean (µs/op) |\n| --- | ---: | ---: |\n")
      if field(bench, "observations") is Array(items) {
        for item in items { out.write_string("| " + cell(field(item, "name")) + " | " + cell(field(item, "iterations")) + " | " + cell(field(item, "mean_us")) + " |\n") }
      }
      let soak = field(read(directory + "/soak.json"), "result")
      out.write_string("\n| Bounded load result | Value |\n| --- | ---: |\n")
      for key in ["duration_ms", "iterations", "objects", "reconcile_failures", "queue_retries", "queue_pending_end", "cache_objects_end", "cache_encoded_bytes_end"] {
        out.write_string("| " + key + " | " + cell(field(soak, key)) + " |\n")
      }
      out.write_string("\nSingle-run timings and a ten-second load observation; RSS availability is explicit in each memory sample, with no GC live-heap claim. Download native-observations for inputs, raw results and source provenance.\n")
      let scale = read("queue-scale-report.json")
      if field(scale, "observations") is Array(items) {
        out.write_string("\n### Queue scale (operation latency, µs)\n\n| Keys | Mode | Mean | P95 | P99 |\n| ---: | --- | ---: | ---: | ---: |\n")
        for item in items { out.write_string("| " + cell(field(item, "keys")) + " | " + cell(field(item, "mode")) + " | " + cell(field(item, "mean_claim_done_us")) + " | " + cell(field(item, "p95_claim_done_us")) + " | " + cell(field(item, "p99_claim_done_us")) + " |\n") }
      }
    }
    "kind" => {
      out.write_string("| Acceptance evidence | Recorded value |\n| --- | --- |\n")
      for (file, key) in [("kind-e2e-report.json", "create_update_drift_restart_gc"), ("cluster-client-report.json", "real_api_crud_patch_paginate_conflict_forbidden_watch"), ("cluster-client-report.json", "tls_verified")] {
        out.write_string("| " + key + " | " + cell(field(read(directory + "/" + file), key)) + " |\n")
      }
      out.write_string("\nKubernetes server: " + cell(field(field(read(directory + "/kind-version.json"), "serverVersion"), "gitVersion")) + ". Download kind-acceptance for reports and runtime package versions.\n")
      let policy = read(directory + "/network-policy-report.json")
      out.write_string("\n### NetworkPolicy enforcement\n\n| Check | Observed |\n| --- | --- |\n")
      for key in ["cni", "allowed_before_and_after", "missing_pod_label_denied", "missing_namespace_label_denied"] {
        out.write_string("| " + key + " | " + cell(field(policy, key)) + " |\n")
      }
      out.write_string("\nA missing policy report is not an enforcement pass. RBAC expected/actual details are preserved in rbac-report.json.\n")
    }
    "memory" => {
      let report = read(directory + "/memory-evidence-report.json")
      out.write_string("| Profile | Limit bytes | Required success | Completed | OOMKilled | Exit code | Peak RSS KiB |\n| --- | ---: | --- | --- | --- | ---: | ---: |\n")
      if field(report, "profiles") is Array(profiles) {
        for item in profiles {
          let mut peak : Json = Json::null()
          if field(field(item, "observation"), "stages") is Array(stages) {
            for stage in stages {
              if field(field(stage, "memory"), "peak_rss_kib") is Number(n, ..) {
                match peak { Number(old, ..) => if n > old { peak = Json::number(n) }; _ => peak = Json::number(n) }
              }
            }
          }
          let state = field(item, "container_state")
          out.write_string("| " + cell(field(item, "profile")) + " | " + cell(field(item, "memory_limit_bytes")) + " | " + cell(field(item, "required_success")) + " | " + cell(field(item, "completed")) + " | " + cell(field(state, "OOMKilled")) + " | " + cell(field(state, "ExitCode")) + " | " + cell(peak) + " |\n")
        }
      }
      out.write_string("\n" + cell(field(report, "acceptance")) + ". Raw stderr, phases and container state are retained. Short observations do not establish 1h/24h stability.\n")
    }
    "wasm" => {
      let report = read(directory + "/wasm-host-report.json")
      out.write_string("Wasmtime: " + cell(field(report, "wasmtime")) + ".\n\n| Case | Expected | Observed | Passed |\n| --- | --- | --- | --- |\n")
      if field(report, "cases") is Array(items) {
        for item in items { out.write_string("| " + cell(field(item, "name")) + " | " + cell(field(item, "expected")) + " | " + cell(field(item, "actual")) + " | " + cell(field(item, "passed")) + " |\n") }
      } else { out.write_string("| Detailed cases | not recorded | not recorded | not recorded |\n") }
      out.write_string("\nDownload wasm-host-evidence for inputs and per-case outcomes. This is a bounded experimental validator probe, not a general isolation proof.\n")
    }
    _ => fail("unknown suite")
  }
  let markdown = out.to_string()
  @fs.write_file("test-results-summary.md", markdown)
  if @env.get_env_var("GITHUB_STEP_SUMMARY") is Some(path) { @fs.write_file(path, markdown, append=true) }
  println("Wrote " + suite + " test result summary")
}
