----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
}
----

///|
async fn map_link(executable : String, binary_sha : String, output : String) -> Json {
  // The map flag is Linux-specific. Leave the checked-out manifest unmodified.
  let manifest = "cmd/moonapp/moon.pkg"
  let original = @fs.read_file(manifest).binary()
  let suffix =
    "\noptions(link: {\"native\": {\"cc-link-flags\": \"-Wl,-Map," +
    output + "/native-link.map\"}})\n"
  let text = @fs.read_file(manifest).text()
  guard !text.contains("cc-link-flags") else { fail("review existing native linker flags before auditing") }
  defer { @fs.write_file(manifest, original) catch { _ => panic() } }
  @fs.write_file(manifest, text + suffix)
  let build = @shell.Cmd("moon", ["build", "cmd/moonapp", "--target", "native", "--release"], stdout=Capture, stderr=Capture).output(timeout_ms=120000, max_output_bytes=1048576)
  if build.exit_code() != 0 { println(build.stderr()) }
  build.check()
  let rebuilt = @shell.Cmd("sha256sum", [executable], stdout=Capture).output()
  rebuilt.check()
  guard rebuilt.stdout().has_prefix(binary_sha + " ") else {
    fail("map-enabled executable differs from the ordinary image executable")
  }
  let map = @fs.read_file(output + "/native-link.map").text()
  guard !map.contains("simdutf.o") && !map.contains("libmoonbitrun.o") else {
    fail("unexpected prebuilt SDK UTF or allocator object in production link map")
  }
  guard map.split_once("Archive member included to satisfy reference by file (symbol)") is Some((_, listing)) else {
    fail("GNU linker map has no archive selection section")
  }
  let selected : Array[String] = []
  for line in listing.split("\n") {
    let entry = line.trim().to_owned()
    if entry.has_prefix("Discarded input sections") ||
      entry.has_prefix("As-needed library included") ||
      entry.has_prefix("Merging program properties") ||
      entry.has_prefix("Allocating common symbols") ||
      entry.has_prefix("Memory Configuration") { break }
    // Indented rows identify the references that caused selection.
    if !line.has_prefix(" ") && !line.has_prefix("\t") &&
      entry.split(" ").next() is Some(field) && field.contains(".a(") {
      selected.push(field.to_owned())
    }
  }
  guard selected.any(entry => entry.contains("libruntime.a(")) else {
    fail("linker map did not identify a known selected archive member")
  }
  let backtrace = selected.filter(entry => entry.contains("/libbacktrace.a("))
  {
    "map_enabled_binary_matches_image": true,
    "selected_archive_members": selected,
    "libbacktrace_selected_members": backtrace,
  }
}

async fn main {
  let args = @env.args()
  guard args.length() == 3 && !@fs.exists(args[2]) else {
    fail("usage: native-link-audit.mbtx EXECVE_TRACE FRESH_OUTPUT_DIRECTORY")
  }
  let trace = @fs.read_file(args[1]).text()
  let output = args[2]
  guard !output.is_empty() && output.all(c => (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') else {
    fail("output must be a simple lowercase directory name")
  }
  let links : Array[String] = []
  for line in trace.split("\n") {
    if line.contains("execve(") && line.contains("moonapp.exe") &&
      (line.contains("/collect2\"") || line.contains("/ld\"") || line.contains("/ld.bfd\"")) &&
      line.has_suffix(" = 0") {
      links.push(line.to_owned())
    }
  }
  guard !links.is_empty() else { fail("no successful Linux executable link invocation captured") }
  guard links.all(line => !line.contains("libmoonbitrun.o")) else {
    fail("unexpected SDK allocator object in production link command")
  }
  let executable = "_build/native/release/build/cmd/moonapp/moonapp.exe"
  let elf = @shell.Cmd("readelf", ["-d", executable], stdout=Capture).output()
  elf.check()
  let symbols = @shell.Cmd("nm", ["-C", "--defined-only", executable], stdout=Capture).output(max_output_bytes=4194304)
  symbols.check()
  // Scalar functions in MoonBit's utf.c share some names with the shim.
  // The GNU link map separately checks both optional object filenames.
  guard !symbols.stdout().trim().is_empty() && !symbols.stdout().contains("simdutf::") else {
    fail("production executable must have auditable symbols and no simdutf C++ library symbols")
  }
  let source = @shell.Cmd("git", ["rev-parse", "HEAD"], stdout=Capture).output()
  source.check()
  let built = @shell.Cmd("sha256sum", [executable], stdout=Capture).output()
  built.check()
  let image = @shell.Cmd("docker", ["image", "inspect", "--format", "{{.Id}}", "moonoperator:dev"], stdout=Capture).output()
  image.check()
  let image_id = image.stdout().trim().to_owned()
  guard image_id.has_prefix("sha256:") && image_id.length() == 71 else { fail("missing immutable production image ID") }
  let installed = @shell.Cmd("docker", ["run", "--rm", "--network", "none", "--read-only", "--entrypoint", "/usr/bin/sha256sum", image_id, "/usr/local/bin/moonoperator"], stdout=Capture).output()
  installed.check()
  let binary_sha = built.stdout().split(" ").next().unwrap().to_owned()
  guard binary_sha.length() == 64 && installed.stdout().has_prefix(binary_sha + " ") else {
    fail("built executable differs from the executable in the production image")
  }
  let builder = @shell.Cmd("dpkg-query", [
    "-W", "-f=${binary:Package}\\t${Version}\\t${source:Package}\\t${source:Version}\\n",
    "libc6-dev", "libgcc-13-dev",
  ], stdout=Capture).output()
  builder.check()
  let compiler = @shell.Cmd("gcc", ["-dumpfullversion"], stdout=Capture).output()
  compiler.check()
  @fs.mkdir(output, recursive=true)
  @fs.write_file(output + "/builder-source-packages.tsv", builder.stdout())
  @fs.write_file(output + "/link-commands.txt", links.join("\n") + "\n")
  @fs.write_file(output + "/elf-dynamic.txt", elf.stdout())
  @fs.write_file(output + "/defined-symbols.txt", symbols.stdout())
  let map_evidence = map_link(executable, binary_sha, output)
  let metadata : Json = {
    "link_map": map_evidence,
    "source_commit": source.stdout().trim().to_owned(),
    "image_id": image_id,
    "sha256": binary_sha,
    "image_binary_matches_build": true,
    "symbol_table_available": true,
    "sdk_allocator_object_absent": true,
    "builder_gcc_version": compiler.stdout().trim().to_owned(),
    "simdutf_sdk_objects_absent": true,
    "simdutf_cpp_symbols_absent": true,
    "scope": "GNU link commands and map, ELF dynamic section and defined symbols for the Linux amd64 production executable",
  }
  @fs.write_file(output + "/link-provenance.json", metadata.stringify(indent=2) + "\n")
}
